# Environment references ONLY. Never put actual secret values in this file.
# deploy-preview.mjs sets DATABASE_URL in the child environment to the validated
# preview connection; Wrangler gives process environment values precedence.
DATABASE_URL=${ORION_PREVIEW_DATABASE_URL}
CLERK_SECRET_KEY=${CLERK_SECRET_KEY}
CLERK_PUBLISHABLE_KEY=${CLERK_PUBLISHABLE_KEY}
